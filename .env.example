# Ingestion API Keys Configuration Example
# Copy this file to .env and fill in the values

GITHUB_TOKEN="your_github_personal_access_token_here"
PRODUCTHUNT_API_KEY="your_producthunt_api_key_here"
PRODUCTHUNT_API_SECRET="your_producthunt_api_secret_here"
YOUTUBE_API_KEY="your_youtube_api_key_here"
PLAYSTORE_CLIENT_ID="your_playstore_client_id_here"
PLAYSTORE_CLIENT_SECRET="your_playstore_client_secret_here"
